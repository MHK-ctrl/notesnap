[TEMPLATE]
# ---------------------------------------------------------------------------
# NoteSnap — environment variables
#
# Copy this file for local development:
#
#   cp .env.example .env.local
#
# `.env.local` is gitignored. Never commit a real key, and never give a key a
# NEXT_PUBLIC_ prefix — anything with that prefix is shipped to the browser.
#
# NoteSnap is bring-your-own-key: each deployer uses their own OCR credentials,
# because every request counts against the account that owns them.
#
# Pick ONE OCR provider. If both keys are somehow set, Cloud Vision wins — it
# is the original provider, so existing deployments keep behaving as before.
# ---------------------------------------------------------------------------

# RECOMMENDED — Gemini API (Google AI Studio): free tier, no credit card.
#
# Read only in server-side code (lib/vision.ts via app/api/transcribe/route.ts).
# It is never sent to the browser.
#
# Create one: https://aistudio.google.com/apikey  (sign in → Create API key)
# Docs:       https://ai.google.dev/gemini-api/docs
# Free-tier limits: https://ai.google.dev/gemini-api/docs/rate-limits
GEMINI_API_KEY=your-gemini-api-key-here

# OPTIONAL — override the Gemini model (default: a current Flash model,
# e.g. gemini-3.8-flash). Smaller models work but read handwriting less
# reliably.
# GEMINI_MODEL=gemini-3.8-flash

# ALTERNATIVE — Google Cloud Vision (the original provider).
#
# Needs the Cloud Vision API enabled AND a Cloud Billing account on the
# project (Google requires billing even though a free monthly tier exists).
# Choose this if you already run a Cloud project; otherwise use GEMINI_API_KEY.
#
# Create one: https://console.cloud.google.com/apis/credentials
# Docs:       https://cloud.google.com/vision/docs/setup
# GOOGLE_VISION_API_KEY=your-google-cloud-vision-api-key-here

# REQUIRED FOR THE PUBLIC DEMO — shared rate limiting and daily budget via Upstash Redis.
#
# Gemini's free-tier quota belongs to the PROJECT, not to this app, and resets at
# midnight Pacific. On a publicly reachable deployment that means any visitor can
# spend the maintainer's daily budget. These two variables are what stop that:
#
#   - Every instance counts in one shared Redis, so the daily cap is real.
#   - If Redis is unreachable the demo FAILS CLOSED (503 demo_unavailable)
#     instead of serving unmetered requests that would burn quota invisibly.
#
# A visitor can also paste their own key in the UI, which spends their own quota
# and bypasses this budget entirely.
#
# Setup:
#   1. Create a free database at https://console.upstash.com
#   2. Copy the REST URL and REST TOKEN from the database page.
# Free tier (2026): 500,000 commands/month, 256 MB — see
# https://upstash.com/pricing/redis for current numbers.
#
# Running without these? /api/transcribe still works, but there is no shared
# daily budget and no cross-instance counting, so a public URL can exhaust the
# project's quota. That is a legitimate choice for a private deployment.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# OPTIONAL — per-IP burst limit. Defaults: 10 requests per 60 seconds.
# Applies to demo AND bring-your-own-key requests.
# RATE_LIMIT_MAX=10
# RATE_LIMIT_WINDOW_MS=60000

# OPTIONAL — demo daily budget. Set these BELOW your project's actual
# requests-per-day limit, so NoteSnap stops serving requests before Google
# starts refusing them.
#
# THERE IS NO UNIVERSALLY SAFE NUMBER. Google's limits are per project AND per
# model, and they differ between free and paid tiers and can change. Read YOUR
# project's number rather than copying the default:
#
#   - AI Studio -> Dashboard -> Usage   (your project's actual consumption)
#   - https://ai.google.dev/gemini-api/docs/rate-limits  (published tiers)
#   - The API itself: a rejected response names the metric, e.g.
#     `quotaMetric: GenerateRequestsPerDay`. The app logs that field when it
#     sees one, so you can set the cap from real evidence.
#
# Leave a margin (say 20-30% below the limit) so NoteSnap closes the demo
# cleanly before Google starts refusing requests, rather than mid-traffic.
#
# DEMO_DAILY_MAX: total transcriptions the demo may serve per Pacific day.
# PER_IP_DAILY_MAX: transcriptions one visitor may make per Pacific day.
#
# These count SUCCESSFUL provider requests: a reservation is refunded when the
# provider clearly refused the call (bad key, disabled API, daily quota gone),
# but not for ambiguous outcomes like a timeout, because the provider may still
# have counted those.
#
# Defaults, for orientation only: 100 total, 10 per IP.
# DEMO_DAILY_MAX=100
# PER_IP_DAILY_MAX=10
