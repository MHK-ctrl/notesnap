[TEMPLATE]
# ---------------------------------------------------------------------------
# NoteSnap — environment variables
#
# Copy this file for local development:
#
#   cp .env.example .env.local
#
# `.env.local` is gitignored. Never commit a real key, and never give a key a
# NEXT_PUBLIC_ prefix — anything with that prefix is shipped to the browser.
#
# NoteSnap is bring-your-own-key: each deployer uses their own OCR credentials,
# because every request counts against the account that owns them.
#
# Pick ONE OCR provider. If both keys are somehow set, Cloud Vision wins — it
# is the original provider, so existing deployments keep behaving as before.
# ---------------------------------------------------------------------------

# RECOMMENDED — Gemini API (Google AI Studio): free tier, no credit card.
#
# Read only in server-side code (lib/vision.ts via app/api/transcribe/route.ts).
# It is never sent to the browser.
#
# Create one: https://aistudio.google.com/apikey  (sign in → Create API key)
# Docs:       https://ai.google.dev/gemini-api/docs
# Free-tier limits: https://ai.google.dev/gemini-api/docs/rate-limits
GEMINI_API_KEY=your-gemini-api-key-here

# OPTIONAL — override the Gemini model (default: a current Flash model,
# e.g. gemini-3.8-flash). Smaller models work but read handwriting less
# reliably.
# GEMINI_MODEL=gemini-3.8-flash

# ALTERNATIVE — Google Cloud Vision (the original provider).
#
# Needs the Cloud Vision API enabled AND a Cloud Billing account on the
# project (Google requires billing even though a free monthly tier exists).
# Choose this if you already run a Cloud project; otherwise use GEMINI_API_KEY.
#
# Create one: https://console.cloud.google.com/apis/credentials
# Docs:       https://cloud.google.com/vision/docs/setup
# GOOGLE_VISION_API_KEY=your-google-cloud-vision-api-key-here

# RECOMMENDED — shared rate limiting through Upstash Redis (REST API).
#
# With these set, /api/transcribe counts requests in Redis, so every serverless
# instance shares one sliding-window limit. Without them it falls back to a
# per-instance in-memory counter, which on Vercel is a speed bump rather than a
# quota — the X-RateLimit-Mode response header says which one answered.
#
# Setup:
#   1. Create a free database at https://console.upstash.com
#   2. Copy the REST URL and REST TOKEN from the database page.
# Free tier (2026): 500,000 commands/month, 256 MB — see
# https://upstash.com/pricing/redis for current numbers.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# OPTIONAL — knobs for the rate limiter. Defaults: 10 requests per 60 seconds.
# RATE_LIMIT_MAX=10
# RATE_LIMIT_WINDOW_MS=60000
