# ---------------------------------------------------------------------------
# NoteSnap — environment variables
#
# Copy this file for local development:
#
#   cp .env.example .env.local
#
# `.env.local` is gitignored. Never commit a real key, and never give a key a
# NEXT_PUBLIC_ prefix — anything with that prefix is shipped to the browser.
#
# NoteSnap is bring-your-own-key: each deployer uses their own Google Cloud
# credentials, because every request is billed to the project that owns them.
# ---------------------------------------------------------------------------

# REQUIRED — a Google Cloud API key with the "Cloud Vision API" enabled.
#
# This value is read only inside the server-side route
# (app/api/transcribe/route.ts). It is never sent to the browser.
#
# Create one: https://console.cloud.google.com/apis/credentials
# Docs:       https://cloud.google.com/vision/docs/setup
GOOGLE_VISION_API_KEY=your-google-cloud-vision-api-key-here

# RECOMMENDED — shared rate limiting through Upstash Redis (REST API).
#
# With these set, /api/transcribe counts requests in Redis, so every serverless
# instance shares one sliding-window limit. Without them it falls back to a
# per-instance in-memory counter, which on Vercel is a speed bump rather than a
# quota — the X-RateLimit-Mode response header says which one answered.
#
# Setup:
#   1. Create a free database at https://console.upstash.com
#   2. Copy the REST URL and REST TOKEN from the database page.
# Free tier (2026): 500,000 commands/month, 256 MB — see
# https://upstash.com/pricing/redis for current numbers.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# OPTIONAL — knobs for the rate limiter. Defaults: 10 requests per 60 seconds.
# RATE_LIMIT_MAX=10
# RATE_LIMIT_WINDOW_MS=60000
